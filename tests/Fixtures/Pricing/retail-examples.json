        },
        {
            "name": "a Pack Price equal to its MRP saves nothing, and 100 g is read as a kilogram",
            "lines": [
                { "packId": 2, "count": 1 }
            ],
            "expected": {
                "lines": [
                    { "packId": 2, "count": 1, "mrp": 12000, "packPrice": 12000, "overridden": false, "lineTotal": 12000, "savings": 0 }
