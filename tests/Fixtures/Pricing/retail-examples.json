{
    "about": "Worked examples of retail pricing (ADR-0034, ADR-0039), run by Pest against App\\Support\\Pricing\\RetailPriceBook and by Vitest against resources/js/lib/retail-pricing.ts. Each line is its Pack Price times its count, with no Tier and no quantity break; its Saving is measured from the Pack's MRP. The Delivery Charge is read from the retail Delivery Zone the District falls in — the zone listing it, else the everywhere-else one: the band the Packs' weight falls in, rounded up to the next whole kilogram, waived once the subtotal reaches that zone's threshold, never waived where it has none, and nothing while the Cart holds no Pack. With no District there is no charge, only the range across every zone, and the distance to free delivery only where every zone agrees. Money is in minor units. An example names only what it changes from the defaults.",
    "defaults": {
        "district": "Dhaka",
        "deliveryZones": [
            { "name": "Everywhere", "districts": [], "everywhereElse": true, "freeDeliveryFrom": 100000, "bands": [
                { "min": 1, "max": null, "fee": 6000 }
            ] }
        ],
        "packs": [
            { "id": 1, "mrp": 30000, "price": 27000, "grams": 250 },
            { "id": 2, "mrp": 12000, "price": 12000, "grams": 100 },
            { "id": 3, "mrp": 55000, "price": 50000, "grams": 500 }
        ]
    },
    "examples": [
        {
            "name": "two of one Pack, short of the threshold, pay the flat charge and are told how far free delivery is",
            "lines": [
                { "packId": 1, "count": 2 }
            ],
            "expected": {
                "lines": [
                    { "packId": 1, "count": 2, "mrp": 30000, "packPrice": 27000, "overridden": false, "lineTotal": 54000, "savings": 6000 }
                ],
                "packCount": 2,
                "kilograms": 1,
                "subtotal": 54000,
                "savings": 6000,
                "deliveryCharge": 6000,
                "deliveryZone": "Everywhere",
                "deliveryBand": { "min": 1, "max": null, "fee": 6000 },
                "deliveryRange": { "least": 6000, "most": 6000 },
                "total": 60000,
                "amountToFreeDelivery": 46000
            }
        },
        {
            "name": "several lines past the threshold are delivered free, each Saving its own",
            "lines": [
                { "packId": 1, "count": 1 },
                { "packId": 2, "count": 3 },
                { "packId": 3, "count": 1 }
            ],
            "expected": {
                "lines": [
                    { "packId": 1, "count": 1, "mrp": 30000, "packPrice": 27000, "overridden": false, "lineTotal": 27000, "savings": 3000 },
                    { "packId": 2, "count": 3, "mrp": 12000, "packPrice": 12000, "overridden": false, "lineTotal": 36000, "savings": 0 },
                    { "packId": 3, "count": 1, "mrp": 55000, "packPrice": 50000, "overridden": false, "lineTotal": 50000, "savings": 5000 }
                ],
                "packCount": 5,
                "kilograms": 2,
                "subtotal": 113000,
                "savings": 8000,
                "deliveryCharge": 0,
                "deliveryZone": "Everywhere",
                "deliveryBand": { "min": 1, "max": null, "fee": 6000 },
                "deliveryRange": { "least": 0, "most": 0 },
                "total": 113000,
                "amountToFreeDelivery": null
            }
        },
        {
            "name": "a subtotal exactly at the threshold has reached it, and a kilogram exactly is one kilogram",
            "lines": [
                { "packId": 3, "count": 2 }
            ],
            "expected": {
                "lines": [
                    { "packId": 3, "count": 2, "mrp": 55000, "packPrice": 50000, "overridden": false, "lineTotal": 100000, "savings": 10000 }
                ],
                "packCount": 2,
                "kilograms": 1,
                "subtotal": 100000,
                "savings": 10000,
                "deliveryCharge": 0,
                "deliveryZone": "Everywhere",
                "deliveryBand": { "min": 1, "max": null, "fee": 6000 },
                "deliveryRange": { "least": 0, "most": 0 },
                "total": 100000,
                "amountToFreeDelivery": null
            }
        },
        {
            "name": "with no threshold, delivery is never free and there is nothing to reach",
            "deliveryZones": [
                { "name": "Everywhere", "districts": [], "everywhereElse": true, "freeDeliveryFrom": null, "bands": [
                    { "min": 1, "max": null, "fee": 6000 }
                ] }
            ],
            "lines": [
                { "packId": 3, "count": 4 }
            ],
            "expected": {
                "lines": [
                    { "packId": 3, "count": 4, "mrp": 55000, "packPrice": 50000, "overridden": false, "lineTotal": 200000, "savings": 20000 }
                ],
                "packCount": 4,
                "kilograms": 2,
                "subtotal": 200000,
                "savings": 20000,
                "deliveryCharge": 6000,
                "deliveryZone": "Everywhere",
                "deliveryBand": { "min": 1, "max": null, "fee": 6000 },
                "deliveryRange": { "least": 6000, "most": 6000 },
                "total": 206000,
                "amountToFreeDelivery": null
