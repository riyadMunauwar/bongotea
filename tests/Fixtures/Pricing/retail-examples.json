                    { "packId": 1, "count": 1, "mrp": 30000, "packPrice": 27000, "overridden": false, "lineTotal": 27000, "savings": 3000 }
                ],
                "packCount": 5,
                "kilograms": 3,
                "subtotal": 227000,
                "savings": 23000,
                "deliveryCharge": 9000,
                "deliveryZone": "Inside Dhaka",
                "deliveryBand": { "min": 3, "max": 5, "fee": 9000 },
                "deliveryRange": { "least": 9000, "most": 18000 },
                "total": 236000,
                "amountToFreeDelivery": 273000
