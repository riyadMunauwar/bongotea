            "district": "Sylhet",
            "deliveryZones": [
                { "name": "Inside Dhaka", "districts": ["Dhaka"], "everywhereElse": false, "freeDeliveryFrom": 500000, "bands": [
                    { "min": 1, "max": 2, "fee": 7000 }, { "min": 3, "max": 5, "fee": 9000 }, { "min": 6, "max": null, "fee": 12000 }
                ] },
                { "name": "Outside Dhaka", "districts": [], "everywhereElse": true, "freeDeliveryFrom": null, "bands": [
                    { "min": 1, "max": 2, "fee": 13000 }, { "min": 3, "max": null, "fee": 18000 }
