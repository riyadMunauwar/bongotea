{
    "about": "Worked examples of the Tier pricing rules (ADR-0028), run by Pest against App\\Support\\Pricing\\PriceBook and by Vitest against resources/js/lib/pricing.ts. Money is in minor units; minorUnitsPerTaka says how many make a whole taka. An example names only what it changes from the defaults.",
    "defaults": {
        "minorUnitsPerTaka": 1,
        "tiers": [
            { "key": "t1", "min": 1, "max": 5 },
            { "key": "t2", "min": 6, "max": 10 },
            { "key": "t3", "min": 11, "max": 15 },
            { "key": "t4", "min": 16, "max": 20 },
            { "key": "t5", "min": 21, "max": 50 },
            { "key": "t6", "min": 51, "max": null }
        ],
        "deliveryBands": [
            { "min": 1, "max": 5, "fee": 120 },
            { "min": 6, "max": 10, "fee": 150 },
            { "min": 11, "max": 20, "fee": 200 },
            { "min": 21, "max": 50, "fee": 250 },
            { "min": 51, "max": null, "fee": 0 }
        ],
        "products": [
            { "id": 1, "regularPrice": 620, "discountType": "percent", "tierDiscounts": { "t2": 5, "t3": 10, "t4": 13, "t5": 16, "t6": 20 } },
            { "id": 2, "regularPrice": 460, "discountType": "fixed", "tierDiscounts": { "t2": 20, "t3": 40, "t4": 60, "t5": 75, "t6": 90 } },
            { "id": 3, "regularPrice": 520, "discountType": "percent", "tierDiscounts": { "t2": 5, "t3": 9, "t4": 12, "t5": 15, "t6": 18 } },
            { "id": 4, "regularPrice": 650, "discountType": "percent", "tierDiscounts": { "t2": 5, "t3": 8, "t4": 12, "t5": 15, "t6": 18 } },
            { "id": 5, "regularPrice": 500, "discountType": "fixed", "tierDiscounts": { "t2": 25, "t4": 70 } }
        ]
    },
    "examples": [
        {
            "name": "the README case: Premium 8 kg and Strong 4 kg are a 12 kg cart in the 11–15 kg Tier",
            "lines": [
                { "productId": 1, "kilograms": 8 },
                { "productId": 2, "kilograms": 4 }
            ],
            "expected": {
                "tier": { "key": "t3", "min": 11, "max": 15 },
                "lines": [
                    { "productId": 1, "kilograms": 8, "regularPrice": 620, "tierPrice": 558, "discount": { "type": "percent", "value": 10 }, "overridden": false, "lineTotal": 4464, "nextTierPrice": 539 },
                    { "productId": 2, "kilograms": 4, "regularPrice": 460, "tierPrice": 420, "discount": { "type": "fixed", "value": 40 }, "overridden": false, "lineTotal": 1680, "nextTierPrice": 400 }
                ],
                "totalKilograms": 12,
                "subtotal": 6144,
                "savings": 656,
                "deliveryCharge": 200,
                "deliveryBand": { "min": 11, "max": 20, "fee": 200 },
                "total": 6344,
                "averagePerKilogram": 512,
                "nextTier": { "tier": { "key": "t4", "min": 16, "max": 20 }, "kilogramsToGo": 4, "extraSaving": 232 },
                "kilogramsToFreeDelivery": 39
            }
        },
        {
            "name": "an empty cart sits in the first Tier with no Delivery Charge",
            "lines": [],
            "expected": {
                "tier": { "key": "t1", "min": 1, "max": 5 },
                "lines": [],
                "totalKilograms": 0,
                "subtotal": 0,
                "savings": 0,
                "deliveryCharge": 0,
                "deliveryBand": null,
                "total": 0,
                "averagePerKilogram": null,
                "nextTier": { "tier": { "key": "t2", "min": 6, "max": 10 }, "kilogramsToGo": 6, "extraSaving": 0 },
                "kilogramsToFreeDelivery": 51
            }
        },
        {
            "name": "5 kg is the top of the first Tier and charges the Regular Price",
            "lines": [{ "productId": 1, "kilograms": 5 }],
            "expected": {
                "tier": { "key": "t1", "min": 1, "max": 5 },
                "lines": [
                    { "productId": 1, "kilograms": 5, "regularPrice": 620, "tierPrice": 620, "discount": null, "overridden": false, "lineTotal": 3100, "nextTierPrice": 589 }
                ],
                "totalKilograms": 5,
                "subtotal": 3100,
                "savings": 0,
                "deliveryCharge": 120,
                "deliveryBand": { "min": 1, "max": 5, "fee": 120 },
                "total": 3220,
                "averagePerKilogram": 620,
                "nextTier": { "tier": { "key": "t2", "min": 6, "max": 10 }, "kilogramsToGo": 1, "extraSaving": 155 },
                "kilogramsToFreeDelivery": 46
            }
        },
        {
            "name": "6 kg crosses into the second Tier and the next Delivery Band",
            "lines": [{ "productId": 1, "kilograms": 6 }],
            "expected": {
                "tier": { "key": "t2", "min": 6, "max": 10 },
                "lines": [
                    { "productId": 1, "kilograms": 6, "regularPrice": 620, "tierPrice": 589, "discount": { "type": "percent", "value": 5 }, "overridden": false, "lineTotal": 3534, "nextTierPrice": 558 }
                ],
                "totalKilograms": 6,
                "subtotal": 3534,
                "savings": 186,
                "deliveryCharge": 150,
                "deliveryBand": { "min": 6, "max": 10, "fee": 150 },
                "total": 3684,
                "averagePerKilogram": 589,
                "nextTier": { "tier": { "key": "t3", "min": 11, "max": 15 }, "kilogramsToGo": 5, "extraSaving": 186 },
                "kilogramsToFreeDelivery": 45
            }
        },
        {
            "name": "a percent discount landing on half a taka rounds up: 650 less 5% is 617.5, charged 618",
            "lines": [{ "productId": 4, "kilograms": 7 }],
            "expected": {
                "tier": { "key": "t2", "min": 6, "max": 10 },
                "lines": [
                    { "productId": 4, "kilograms": 7, "regularPrice": 650, "tierPrice": 618, "discount": { "type": "percent", "value": 5 }, "overridden": false, "lineTotal": 4326, "nextTierPrice": 598 }
                ],
                "totalKilograms": 7,
                "subtotal": 4326,
                "savings": 224,
                "deliveryCharge": 150,
                "deliveryBand": { "min": 6, "max": 10, "fee": 150 },
                "total": 4476,
                "averagePerKilogram": 618,
                "nextTier": { "tier": { "key": "t3", "min": 11, "max": 15 }, "kilogramsToGo": 4, "extraSaving": 140 },
                "kilogramsToFreeDelivery": 44
            }
        },
        {
            "name": "a Tier the Product says nothing about charges the Tier below's price",
            "lines": [{ "productId": 5, "kilograms": 12 }],
