{
    "about": "Worked examples of the Tier pricing rules (ADR-0031), run by Pest against App\\Support\\Pricing\\PriceBook and by Vitest against resources/js/lib/pricing.ts. Each Product owns its Tiers; every line is priced from its own Product's Tier for the whole Cart's Kilograms, and its Saving is measured from the Product's MRP. The Delivery Charge is read by the same total from the bands of the Delivery Zone the District falls in (ADR-0039) — the zone listing it, else the everywhere-else one; with no District there is no charge, only the range across every zone, and the nudge towards free delivery only where every zone agrees. Money is in minor units. An example names only what it changes from the defaults.",
    "defaults": {
        "district": "Dhaka",
        "deliveryZones": [
            { "name": "Everywhere", "districts": [], "everywhereElse": true, "bands": [
                { "min": 1, "max": 5, "fee": 120 },
                { "min": 6, "max": 10, "fee": 150 },
                { "min": 11, "max": 20, "fee": 200 },
                { "min": 21, "max": 50, "fee": 250 },
                { "min": 51, "max": null, "fee": 0 }
            ] }
        ],
        "products": [
            { "id": 1, "mrp": 620, "tiers": [
                { "min": 1, "max": 5, "price": 620 }, { "min": 6, "max": 10, "price": 589 }, { "min": 11, "max": 15, "price": 558 },
                { "min": 16, "max": 20, "price": 539 }, { "min": 21, "max": 50, "price": 521 }, { "min": 51, "max": null, "price": 496 }
            ] },
            { "id": 2, "mrp": 460, "tiers": [
                { "min": 1, "max": 5, "price": 460 }, { "min": 6, "max": 10, "price": 440 }, { "min": 11, "max": 15, "price": 420 },
                { "min": 16, "max": 20, "price": 400 }, { "min": 21, "max": 50, "price": 385 }, { "min": 51, "max": null, "price": 370 }
            ] },
            { "id": 3, "mrp": 520, "tiers": [
                { "min": 1, "max": 3, "price": 520 }, { "min": 4, "max": 20, "price": 495 }, { "min": 21, "max": null, "price": 470 }
            ] },
            { "id": 4, "mrp": 650, "tiers": [
                { "min": 1, "max": null, "price": 650 }
            ] },
            { "id": 5, "mrp": 500, "tiers": [
                { "min": 1, "max": 5, "price": 500 }, { "min": 6, "max": 10, "price": 475 }, { "min": 11, "max": 15, "price": 475 }, { "min": 16, "max": null, "price": 430 }
            ] },
            { "id": 6, "mrp": 700, "tiers": [
                { "min": 1, "max": 5, "price": 650 }, { "min": 6, "max": null, "price": 600 }
            ] }
        ]
    },
